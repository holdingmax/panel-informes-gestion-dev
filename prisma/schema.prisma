// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id                  String    @id @default(cuid())
  username            String    @unique
  passwordHash        String
  role                Role      @default(USER)
  securityQuestion    String
  securityAnswerHash  String
  active              Boolean   @default(true)
  // Límite de intentos del recupero de contraseña por pregunta de
  // seguridad: a los 5 intentos fallidos seguidos se bloquea 30 minutos.
  failedResetAttempts Int       @default(0)
  resetLockedUntil    DateTime?
  // Mismo esquema para el login.
  failedLoginAttempts Int       @default(0)
  loginLockedUntil    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  permisosUnidad UserUnidadPermiso[]
}

// Permisos de un usuario (no-ADMIN, que ve/edita todo) sobre una Unidad de
// Negocio puntual — unidadNegocioId null = aplica a TODAS las unidades
// (incluidas las que se creen después), para no tener que mantener una fila
// por unidad. Dos árboles independientes, uno por ventana del sistema:
//  - CONSULTA (/consulta): puedeConsultar (acceso a la ventana) y, dentro,
//    revisar / aprobar / adjuntar.
//  - CONFECCIÓN (/preparacion-informes): puedeConfeccionar (acceso a la
//    ventana, cargar BSyS y crear informes) y, dentro, configuración /
//    reclasificar / eliminar.
// Los hijos solo valen si está el booleano de acceso de su árbol (lo fuerza
// setPermisoUnidad). Una fila sin ningún booleano en true no se guarda.
model UserUnidadPermiso {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  unidadNegocioId    Int?
  unidadNegocio      UnidadNegocio? @relation(fields: [unidadNegocioId], references: [codUnidad])
  puedeConsultar     Boolean        @default(false)
  puedeRevisar       Boolean        @default(false)
  puedeAprobar       Boolean        @default(false)
  puedeAdjuntar      Boolean        @default(false)
  puedeConfeccionar  Boolean        @default(false)
  puedeConfiguracion Boolean        @default(false)
  puedeReclasificar  Boolean        @default(false)
  puedeEliminar      Boolean        @default(false)

  @@unique([userId, unidadNegocioId])
}

// El "grupo" que se ve en la pantalla principal y con el que se confecciona
// un informe: puede combinar el Plan de Cuentas de una o más Empresas (ver
// modelo Empresa) — cada una con su propio BSyS, consolidados en un solo
// informe para esta unidad.
model UnidadNegocio {
  codUnidad    Int      @id @default(autoincrement())
  nombreUnidad String   @db.VarChar(35)
  imagenUnidad Bytes?
  imagenMime   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresas             Empresa[]
  informes             Informe[]
  resultadosHistoricos ResultadosHistoricos[]
  permisos             UserUnidadPermiso[]

  seriesTablaId Int?
  seriesTabla   SeriesEIndicesTabla? @relation(fields: [seriesTablaId], references: [codTabla])
}

// La entidad contable real: tiene su propio Plan de Cuentas y su propio BSyS
// (Mes y Acumulado). Se vincula a una Unidad de Negocio desde la pantalla de
// configuración de esta última.
model Empresa {
  codEmp    Int      @id @default(autoincrement())
  nombreEmp String   @db.VarChar(60)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unidadNegocioId Int?
  unidadNegocio   UnidadNegocio? @relation(fields: [unidadNegocioId], references: [codUnidad])

  monedaPrimariaId Int?
  monedaPrimaria   Moneda? @relation("EmpresaMonedaPrimaria", fields: [monedaPrimariaId], references: [codMoneda])
  // Presenta los cuadros Nominal y (si corresponde) Ajustado por Inflación
  // en miles de la moneda primaria en vez de en unidades — no afecta a la
  // moneda secundaria, que siempre se muestra en unidades.
  presentaEnMiles  Boolean @default(false)

  monedaSecundariaId Int?
  monedaSecundaria   Moneda? @relation("EmpresaMonedaSecundaria", fields: [monedaSecundariaId], references: [codMoneda])

  actualiza Boolean @default(false)

  monedaActualizaId Int?
  monedaActualiza   Moneda? @relation("EmpresaMonedaActualiza", fields: [monedaActualizaId], references: [codMoneda])

  balances          BalanceSumasYSaldos[]
  planDeCuentas     PlanDeCuentas[]
  reclasificaciones Reclasificacion[]
}

// Catálogo de monedas usado por Empresa para elegir su moneda primaria,
// secundaria y — si "actualiza" está activo — la moneda en la que se
// actualizan sus saldos.
model Moneda {
  codMoneda Int    @id @default(autoincrement())
  nomMoneda String @unique @db.VarChar(60)
  simbolo   String @db.VarChar(5)

  empresasPrimaria   Empresa[] @relation("EmpresaMonedaPrimaria")
  empresasSecundaria Empresa[] @relation("EmpresaMonedaSecundaria")
  empresasActualiza  Empresa[] @relation("EmpresaMonedaActualiza")
}

enum EstadoInforme {
  PROCESO
  EN_REVISION
  APROBADO
}

model Informe {
  id              String        @id @default(cuid())
  unidadNegocio   UnidadNegocio @relation(fields: [unidadNegocioId], references: [codUnidad])
  unidadNegocioId Int
  periodoMes      Int
  periodoAnio     Int
  // Un informe de un período ya Aprobado es inmodificable — volver a
  // confeccionar ese mismo período crea una fila nueva con version+1 en vez
  // de pisarlo (ver bsys-import.ts). 1 = original, nunca se muestra en la
  // UI; 2+ se muestra como "versión X".
  version         Int           @default(1)
  estado          EstadoInforme @default(PROCESO)
  // Independiente de `estado`: un informe puede estar Aprobado pero todavía
  // no pasó la auditoría externa. Mientras sea false, el PDF muestra el
  // recuadro "INFORME PROVISORIO" en todas las hojas (ver informe-pdf.tsx).
  // Default false — el operador lo marca manualmente una vez que audita.
  auditado        Boolean       @default(false)
  // Se completa al pasar a APROBADO (ver avanzarEstadoInforme) y nunca se
  // vuelve a tocar — null significa que el informe todavía se recalcula en
  // vivo contra el Plan de Cuentas actual. Ver computeInformeReport.
  snapshot        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reclasificaciones Reclasificacion[]
  adjuntos          InformeAdjunto[]

  @@unique([unidadNegocioId, periodoMes, periodoAnio, version])
}

enum TipoBSyS {
  MES
  ACUMULADO
}

enum EstadoBSyS {
  PROVISORIO
  DEFINITIVO
}

model BalanceSumasYSaldos {
  id               String     @id @default(cuid())
  empresa          Empresa    @relation(fields: [empresaId], references: [codEmp])
  empresaId        Int
  tipo             TipoBSyS
  // Período que cubre esta carga (no el período en que se subió el
  // archivo): el motor de informes filtra por esto, no solo por
  // fechaCarga más reciente, para que aprobar un período nuevo no
  // cambie los números de uno ya cerrado.
  periodoMes       Int
  periodoAnio      Int
  fechaCarga       DateTime
  cuenta           String     @db.VarChar(90)
  saldoIniDebe     Decimal    @db.Decimal(18, 2)
  saldoIniHaber    Decimal    @db.Decimal(18, 2)
  sumasDebe        Decimal    @db.Decimal(18, 2)
  sumasHaber       Decimal    @db.Decimal(18, 2)
  saldoCierreDebe  Decimal    @db.Decimal(18, 2)
  saldoCierreHaber Decimal    @db.Decimal(18, 2)
  estado           EstadoBSyS @default(PROVISORIO)
  createdAt        DateTime   @default(now())

  @@index([empresaId, tipo, periodoAnio, periodoMes, fechaCarga])
}

// El "rol" interno que el motor de informes necesita para saber en qué
// bucket cae cada Tipo (ACTIVO/PASIVO/PATRIMONIO_NETO van al Balance,
// RESULTADO al Estado de Resultados). Un Tipo sin rol (ej. "Cuenta de
// Orden") queda afuera del Balance y del Resultado — ver exigeSaldoCero.
enum RolTipoPartida {
  ACTIVO
  PASIVO
  PATRIMONIO_NETO
  RESULTADO
}

// Catálogo real (administrable en Configuración) de los "Tipo" que puede
// tener una Partida Patrimonial. Además del rol interno, un Tipo puede
// marcarse "exigeSaldoCero": son partidas que por diseño siempre deben
// netear a cero (ej. Cuenta de Orden) — el motor de informes avisa al
// operador si alguna vez no es así, en vez de dejarlo pasar en silencio.
// "exposicionCambiante" es la otra alternativa a un rol fijo: sin un Rol
// asignado (rol null), el motor decide cada período si el Rubro va al
// Activo o al Pasivo según el signo del saldo final (Debe = Activo, Haber
// = Pasivo) — ver resolverTipoPartida en balance-oya-report.ts. Mutuamente
// excluyente en la práctica con exigeSaldoCero (una partida no puede a la
// vez "siempre netear cero" y "exponerse según el signo").
model TipoPartida {
  codTipo             Int                  @id @default(autoincrement())
  nomTipo             String               @unique @db.VarChar(40)
  rol                 RolTipoPartida?
  exigeSaldoCero      Boolean              @default(false)
  exposicionCambiante Boolean              @default(false)
  partidas            PartidaPatrimonial[]
}

model PartidaPatrimonial {
  codPartida Int          @id @default(autoincrement())
  nomPartida String       @unique @db.VarChar(40)
  tipoId     Int?
  tipo       TipoPartida? @relation(fields: [tipoId], references: [codTipo])
  rubros     Rubro[]
}

enum BucketNOF {
  OPERATIVO
  NO_OPERATIVO
  FINANCIAMIENTO
}

// Los 5 campos del cuadro de Resultado Nominal (ver resultado-nominal.ts) —
// se clasifican por Subrubro (ver modelo Subrubro), exclusivo de los
// Rubros de Partida Resultado (Ingresos/Egresos).
enum CampoResultado {
  VENTAS
  COSTOS_DIRECTOS
  GASTOS_OPERATIVOS
  EXPENSAS
  OTRAS_GANANCIAS_PERDIDAS
}

model Rubro {
  codRubro             Int                 @id @default(autoincrement())
  nomRubro             String              @unique @db.VarChar(60)
  // El tipo (Activo/Pasivo/Patrimonio Neto/Resultado) de TODAS las cuentas
  // de este Rubro sale de acá — ya no se clasifica cuenta por cuenta (ver
  // PlanDeCuentas), para que una cuenta suelta mal cargada no pueda
  // arrastrar mal a todo el rubro. Null solo en un Rubro que nunca se usó.
  partidaPatrimonialId Int?
  partidaPatrimonial   PartidaPatrimonial? @relation(fields: [partidaPatrimonialId], references: [codPartida])
  // Default de NOF a nivel Rubro (atajo "CTO/ONP/ARS" desde el ESP) — una
  // cuenta puntual clasificada en Configuración → Categoría OyA sigue
  // ganando por sobre este default (ver computeInformeReport).
  bucketNOF            BucketNOF?
  // Orden de exposición dentro del ESP (Activo/Pasivo/Patrimonio Neto se
  // ordenan por este valor, de menor a mayor; null queda al final, en el
  // orden en que se insertó el Rubro). No afecta a ninguna otra hoja.
  orden                Int?
  planes               PlanDeCuentas[]
}

// Exclusivo de los Rubros de Partida Resultado (Ingresos/Egresos): decide
// a qué campo del Estado de Resultados va cada cuenta (campoResultado). En
// cuentas de cualquier otro Rubro este campo no se usa — ahí se usan
// Subrubro2/Subrubro3 en su lugar, solo como ayuda visual, sin ningún rol
// en ningún cálculo.
model Subrubro {
  codSubrubro    Int             @id @default(autoincrement())
  nomSubrubro    String          @unique @db.VarChar(60)
  campoResultado CampoResultado?
  planes         PlanDeCuentas[]
}

model Subrubro2 {
  codSubrubro2 Int             @id @default(autoincrement())
  nomSubrubro2 String          @unique @db.VarChar(60)
  planes       PlanDeCuentas[]
}

model Subrubro3 {
  codSubrubro3 Int             @id @default(autoincrement())
  nomSubrubro3 String          @unique @db.VarChar(60)
  planes       PlanDeCuentas[]
}

// Clasifica cada cuenta del Plan de Cuentas (no el Rubro) para armar la hoja
// de Necesidades Operativas de Fondos: dos cuentas de un mismo Rubro pueden
// caer en categorías distintas si hiciera falta.
model CategoriaOyA {
  codOyA    Int             @id @default(autoincrement())
  nomOyA    String          @unique @db.VarChar(60)
  bucketNOF BucketNOF?
  planes    PlanDeCuentas[]
}

// Una Unidad de Negocio puede necesitar su propia serie de índice/dólar (ej.
// otro rubro de actividad, otro criterio de actualización) — cada
// SeriesEIndicesTabla es una serie independiente, mensual y correlativa
// (sin huecos) desde su primer período hasta el presente, y una misma tabla
// puede servir a más de una Unidad de Negocio (ver UnidadNegocio.seriesTabla).
model SeriesEIndicesTabla {
  codTabla  Int              @id @default(autoincrement())
  tipoTabla String           @db.VarChar(60)
  filas     SeriesEIndices[]
  unidades  UnidadNegocio[]
}

// Índice y Dólar son opcionales: Índice solo hace falta si alguna Empresa
// que usa esta tabla tiene "Actualiza" en Sí (ajuste por inflación), Dólar
// solo si alguna tiene Moneda secundaria configurada — una tabla puede no
// necesitar ninguno de los dos, o solo uno. Lo que no se admite es una
// mezcla dentro de la misma columna (algunos períodos con valor y otros
// sin él): o está completa para todos los períodos, o vacía para todos —
// ver verificarConsistenciaColumnas en series-e-indices-actions.ts.
model SeriesEIndices {
  id      String              @id @default(cuid())
  tablaId Int
  tabla   SeriesEIndicesTabla @relation(fields: [tablaId], references: [codTabla])
  periodo DateTime            @db.Date
  indice  Decimal?            @db.Decimal(18, 6)
  dolar   Decimal?            @db.Decimal(18, 4)

  @@unique([tablaId, periodo])
}

// Un registro por empresa y período con los 5 componentes "de resultado" en
// pesos nominales. Se completa a mano para períodos anteriores a la puesta en
// marcha del sistema, y automáticamente al aprobar un Informe (ver
// informe-actions.ts) — nunca se pisa un período que ya tiene datos.
model ResultadosHistoricos {
  id                      String        @id @default(cuid())
  unidadNegocio           UnidadNegocio @relation(fields: [unidadNegocioId], references: [codUnidad])
  unidadNegocioId         Int
  periodoMes              Int
  periodoAnio             Int
  ventas                  Decimal       @db.Decimal(18, 2)
  costosDirectos          Decimal       @db.Decimal(18, 2)
  gastosOperativos        Decimal       @db.Decimal(18, 2)
  expensas                Decimal       @db.Decimal(18, 2)
  otrasGananciasYPerdidas Decimal       @db.Decimal(18, 2)
  createdAt               DateTime      @default(now())

  @@unique([unidadNegocioId, periodoMes, periodoAnio])
}

model PlanDeCuentas {
  id        String   @id @default(cuid())
  empresa   Empresa  @relation(fields: [empresaId], references: [codEmp])
  empresaId Int
  cuenta    String   @db.VarChar(90)
  // Opcional — decide si la cuenta entra al ESP (y con qué Partida) y en
  // qué posición. Una cuenta de Resultado (Ingresos/Egresos) no lleva
  // Rubro: el ESP se arma exclusivamente con las cuentas que sí lo tienen.
  rubro     Rubro?   @relation(fields: [rubroId], references: [codRubro])
  rubroId   Int?
  // Opcional — decide si la cuenta entra al ER (cuadro Nominal) y a qué
  // campo aporta. Independiente de Rubro: una cuenta puede tener uno,
  // el otro, ambos o ninguno todavía (ver los avisos "HAY CUENTAS SIN
  // VALORES EN RUBRO/SUBRUBRO" en computeInformeReport/computeResultadoCuadro).
  subrubro       Subrubro?     @relation(fields: [subrubroId], references: [codSubrubro])
  subrubroId     Int?
  subrubro2      Subrubro2?    @relation(fields: [subrubro2Id], references: [codSubrubro2])
  subrubro2Id    Int?
  subrubro3      Subrubro3?    @relation(fields: [subrubro3Id], references: [codSubrubro3])
  subrubro3Id    Int?
  categoriaOyA   CategoriaOyA? @relation(fields: [categoriaOyAId], references: [codOyA])
  categoriaOyAId Int?

  reclasificacionLineas ReclasificacionLinea[]

  @@unique([empresaId, cuenta])
}

// Ajuste extracontable, momentáneo, solo para la exposición de ESTE informe
// — nunca toca BalanceSumasYSaldos ni el Plan de Cuentas. Mueve saldo entre
// cuentas de la misma Empresa; sus líneas deben sumar cero (debe = haber en
// total) para poder guardarse. Se aplica tanto al ESP (BSyS Acumulado) como
// al ER (BSyS Mes) — ver buildEmpresaBalanceInputs / computeResultadoNominalMesDeEmpresa.
model Reclasificacion {
  id        String   @id @default(cuid())
  informe   Informe  @relation(fields: [informeId], references: [id], onDelete: Cascade)
  informeId String
  empresa   Empresa  @relation(fields: [empresaId], references: [codEmp])
  empresaId Int
  detalle   String   @db.VarChar(500)
  // Null si el usuario que la cargó se borró después — no se pierde la
  // reclasificación por eso.
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineas   ReclasificacionLinea[]
  adjuntos ReclasificacionAdjunto[]
}

model ReclasificacionLinea {
  id                String          @id @default(cuid())
  reclasificacion   Reclasificacion @relation(fields: [reclasificacionId], references: [id], onDelete: Cascade)
  reclasificacionId String
  planDeCuenta      PlanDeCuentas   @relation(fields: [planDeCuentaId], references: [id])
  planDeCuentaId    String
  debe              Decimal         @db.Decimal(18, 2)
  haber             Decimal         @db.Decimal(18, 2)
}

// Mismo patrón que UnidadNegocio.imagenUnidad (Bytes en Postgres) — tope de
// 10MB por archivo validado en el server action, no acá.
model ReclasificacionAdjunto {
  id                String          @id @default(cuid())
  reclasificacion   Reclasificacion @relation(fields: [reclasificacionId], references: [id], onDelete: Cascade)
  reclasificacionId String
  nombreArchivo     String          @db.VarChar(255)
  mimeType          String
  contenido         Bytes
  createdAt         DateTime        @default(now())
}

// Documentación general adjuntada a un Informe desde el panel Consulta
// (gateado por UserUnidadPermiso.puedeAdjuntar) — distinto de
// ReclasificacionAdjunto, que respalda un ajuste puntual.
model InformeAdjunto {
  id              String   @id @default(cuid())
  informe         Informe  @relation(fields: [informeId], references: [id], onDelete: Cascade)
  informeId       String
  nombreArchivo   String   @db.VarChar(255)
  mimeType        String
  contenido       Bytes
  createdByUserId String?
  createdAt       DateTime @default(now())
}
