# Cadena de conexión a PostgreSQL (Neon en producción/testing, local en desarrollo)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Auth.js — genera un valor con: npx auth secret
AUTH_SECRET=""

# Credenciales del primer usuario admin, usadas solo por prisma/seed.ts
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_SECURITY_QUESTION="¿Cuál es el nombre de tu primera mascota?"
SEED_ADMIN_SECURITY_ANSWER=""
